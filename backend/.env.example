# Copy this file to .env and fill in real values. .env is git-ignored —
# never commit real secrets.

# --- Core -------------------------------------------------------------
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me-before-deploying
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# --- Database -----------------------------------------------------------
# Defaults to SQLite for local development. To use PostgreSQL later, set:
#   DB_ENGINE=django.db.backends.postgresql
#   DB_NAME=fitwise
#   DB_USER=fitwise
#   DB_PASSWORD=...
#   DB_HOST=localhost
#   DB_PORT=5432
# No other code changes are required — every app talks to the Django ORM
# only, never to SQLite-specific SQL.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# --- JWT ------------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- CORS (the Vite dev server) --------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
